            },
            "ready": {
              ".validate": "newData.isBoolean()"
            },
            "status": {
              ".validate": "newData.isString() && newData.val().matches(/^(waiting|playing|finished|gaveup)$/)"
            },
            "legTimes": {
              "$i": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              }
            },
            "steps": {
              "$i": {
                "title": {
                  ".validate": "newData.isString() && newData.val().length <= 300"
                }
              }
            },
            "pos": {
              "x": {
                ".validate": "newData.isNumber()"
              },
              "y": {
                ".validate": "newData.isNumber()"
              },
              "run": {
                ".validate": "newData.isBoolean()"
              }
            },
            "sid": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "ext": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            }
          }
        },
        "hostId": {
          ".validate": "newData.isString() && (newData.val() === data.val() || !data.exists() || data.val() === auth.uid || root.child('admins').child(auth.uid).val() === true || (newData.val() === auth.uid && (!data.parent().child('players').child(data.val()).child('name').exists() || data.parent().child('players').child(data.val()).child('online').val() !== true)))"
        },
        "closed": {
          ".validate": "data.parent().child('hostId').val() === auth.uid || root.child('admins').child(auth.uid).val() === true"
        },
        "winners": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3"
        },
        "kicked": {
          "$pid": {
            ".validate": "data.parent().parent().child('hostId').val() === auth.uid || root.child('admins').child(auth.uid).val() === true"
          }
        },
        "locked": {
          ".validate": "newData.isBoolean() && (data.parent().child('hostId').val() === auth.uid || root.child('admins').child(auth.uid).val() === true)"
        }
      }
    },
    "lobbies": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('approved').val() === true || auth.provider === 'anonymous')",
        ".validate": "$code.matches(/^[A-Z0-9]{4}$/)",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "count": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30"
        }
      }
    },
    "daily": {
      ".read": "auth != null",
      "$date": {
        ".validate": "$date.matches(/^20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/)",
        "puzzle": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true && !data.exists()",
          ".validate": "newData.hasChildren(['start', 'targets'])"
        },
        "best": {
          "$pid": {
            ".write": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true && (auth.uid === $pid || root.child('admins').child(auth.uid).val() === true)",
            ".validate": "newData.hasChildren(['name', 'ms'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "ms": {
              ".validate": "newData.isNumber() && newData.val() > 0"
            },
            "at": {
              ".validate": "newData.val() === now"
            }
          }
        }
      }
    },
    "nicks": {
      ".read": "auth != null",
      "$k": {
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()) || root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.isString() && (root.child('admins').child(auth.uid).val() === true || newData.parent().parent().child('users').child(auth.uid).child('nick').val().toLowerCase().replace(' ', '').replace('.', '_').replace('$', '_').replace('#', '_').replace('[', '_').replace(']', '_').replace('/', '_') === $k)"
      }
    },
    "presence": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "conns": {
          "$c": {
            ".validate": "newData.hasChildren(['where', 'at']) && newData.child('at').isNumber()",
            "where": {
              ".validate": "newData.isString() && newData.val().matches(/^(home|shop|lobby|playing|results)$/)"
            },
            "room": {
              ".validate": "newData.isString() && newData.val().length <= 8"
            },
            "daily": {
              ".validate": "newData.isBoolean()"
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "lastSeen": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "notice": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".validate": "newData.hasChildren(['id', 'title', 'body', 'at'])",
      "id": {
        ".validate": "newData.isNumber()"
      },
      "title": {
        ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
      },
      "body": {
        ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 1000"
      },
      "at": {
        ".validate": "newData.isNumber()"
      },
      "by": {
        ".validate": "newData.isString()"
      },
      "$other": {
        ".validate": false
      }
    },
    "vault": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.uid === root.child('users').child($uid).child('rcv').val())",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['salt', 'iv', 'ct']) && newData.child('salt').isString() && newData.child('iv').isString() && newData.child('ct').isString() && newData.child('ct').val().length <= 2000"
      }
    },
    "keys": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['salt', 'iv', 'ct']) && newData.child('salt').isString() && newData.child('iv').isString() && newData.child('ct').isString() && newData.child('ct').val().length <= 2000"
      }
    },
    "roomPw": {
      "$code": {
        ".read": "auth != null && (root.child('rooms').child($code).child('hostId').val() === auth.uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && (root.child('rooms').child($code).child('hostId').val() === auth.uid || root.child('admins').child(auth.uid).val() === true || (!newData.exists() && !newData.parent().parent().child('rooms').child($code).exists()))",
        ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}$/)"
      }
    },
    "roomKeys": {
      "$code": {
        ".write": "auth != null && !newData.exists() && !newData.parent().parent().child('rooms').child($code).exists()",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['pw', 'at']) && newData.child('pw').isString() && newData.child('pw').val().length <= 4 && newData.child('at').val() === now && (!data.exists() || data.child('at').val() < now - 2000)"
        }
      }
    }
  }
}
