{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": true,
        ".write": true,
        ".validate": "$code.matches(/^[A-Z0-9]{4}$/)",
        "mode": {
          ".validate": "newData.val() === 'time' || newData.val() === 'clicks' || newData.val() === 'relay'"
        },
        "legs": {
          ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 5"
        },
        "timeLimitMin": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30"
        },
        "state": {
          ".validate": "newData.val() === 'lobby' || newData.val() === 'playing' || newData.val() === 'results'"
        },
        "chat": {
          "$msg": {
            ".validate": "newData.hasChildren(['pid', 'text'])",
            "text": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            }
          }
        },
        "players": {
          "$pid": {
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "path": {
              ".validate": "newData.hasChildren()"
            }
          }
        }
      }
    },
    "lobbies": {
      ".read": true,
      "$code": {
        ".write": true,
        ".validate": "$code.matches(/^[A-Z0-9]{4}$/)",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "count": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30"
        }
      }
    },
    "daily": {
      ".read": true,
      "$date": {
        ".validate": "$date.matches(/^20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/)",
        "puzzle": {
          ".write": "!data.exists()",
          ".validate": "newData.hasChildren(['start', 'targets'])"
        },
        "best": {
          "$pid": {
            ".write": true,
            ".validate": "newData.hasChildren(['name', 'ms'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "ms": {
              ".validate": "newData.isNumber() && newData.val() > 0"
            }
          }
        }
      }
    }
  }
}