{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      ".read": "auth != null"
    },
    "ids": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || root.child('admins').child(auth.uid).val() === true)",
        ".validate": "$id.matches(/^[a-z0-9_]{4,16}$/)"
      }
    },
    "private": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && ((auth.uid === $uid && !data.exists()) || root.child('admins').child(auth.uid).val() === true)",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
        }
      }
    },
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && ((auth.uid === $uid && !data.exists() && newData.child('approved').val() === true && newData.child('points').val() === 0) || root.child('admins').child(auth.uid).val() === true)",
        "id": {
          ".validate": "newData.isString() && newData.parent().parent().parent().child('ids').child(newData.val()).val() === $uid"
        },
        "approved": {
          ".write": "auth != null && auth.uid === $uid && newData.val() === true && data.parent().child('suspended').val() !== true",
          ".validate": "newData.isBoolean()"
        },
        "nick": {
          ".write": "auth != null && auth.uid === $uid && data.exists() && data.parent().child('approved').val() === true",
          ".validate": "newData.isString() && newData.val().length >= 1 && (newData.val().length <= 8 || newData.val() === data.val()) && (!data.exists() || newData.val() === data.val() || root.child('admins').child(auth.uid).val() === true || newData.parent().child('points').val() === data.parent().child('points').val() - 300)"
        },
        "points": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true",
          ".validate": "newData.isNumber() && newData.val() >= 0 && ((!data.exists() && newData.val() === 0) || newData.val() === data.val() || (auth.uid === $uid && newData.val() < data.val()) || (auth.uid === $uid && (newData.parent().child('lastWin/code').val() !== data.parent().child('lastWin/code').val() || newData.parent().child('lastWin/round').val() !== data.parent().child('lastWin/round').val()) && newData.val() === data.val() + newData.parent().child('lastWin/amt').val()) || (newData.parent().child('lastDaily/date').val() !== data.parent().child('lastDaily/date').val() && newData.val() === data.val() + newData.parent().child('lastDaily/amt').val()) || root.child('admins').child(auth.uid).val() === true)"
        },
        "lastWin": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['code', 'round', 'amt']) && (newData.child('amt').val() === 100 || newData.child('amt').val() === 50 || newData.child('amt').val() === 30) && root.child('rooms').child(newData.child('code').val()).child('round').val() === newData.child('round').val() && root.child('rooms').child(newData.child('code').val()).child('state').val() === 'results' && root.child('rooms').child(newData.child('code').val()).child('players').child($uid).child('status').val() === 'finished' && newData.child('rid').isString() && (root.child('rooms').child(newData.child('code').val()).child('rid').val() === newData.child('rid').val()     || (!root.child('rooms').child(newData.child('code').val()).child('rid').exists() && newData.child('rid').val() === newData.child('code').val())) && (!root.child('claims').child(newData.child('rid').val()).child($uid).exists() || root.child('claims').child(newData.child('rid').val()).child($uid).val() < newData.child('round').val()) && newData.parent().parent().parent().child('claims').child(newData.child('rid').val()).child($uid).val() === newData.child('round').val()"
        },
        "lastDaily": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true",
          ".validate": "newData.hasChildren(['date', 'amt']) && (newData.child('amt').val() === 100 || newData.child('amt').val() === 50 || newData.child('amt').val() === 30) && root.child('daily').child(newData.child('date').val()).child('best').child($uid).exists() && !root.child('dailyPaid').child(newData.child('date').val()).exists() && newData.parent().parent().parent().child('dailyPaid').child(newData.child('date').val()).exists()"
        },
        "lastGame": {
          ".write": "auth != null && auth.uid === $uid"
        },
        "stats": {
          "$k": {
            ".write": "auth != null && (auth.uid === $uid || (root.child('users').child(auth.uid).child('approved').val() === true && !root.child('dailyPaid').child(newData.parent().parent().child('lastDaily/date').val()).exists() && newData.parent().parent().parent().parent().child('dailyPaid').child(newData.parent().parent().child('lastDaily/date').val()).exists()))",
            ".validate": "newData.isNumber() && (!data.exists() || newData.val() >= data.val())"
          }
        },
        "owned": {
          "animals": {
            "$a": {
              ".write": "auth != null && ((auth.uid === $uid && newData.exists()) || root.child('admins').child(auth.uid).val() === true)",
              ".validate": "newData.val() === true && $a.matches(/^(rabbit|penguin|chick|panda|dog|dinosaur|bear|fox|sheep)$/) && (data.exists() || root.child('admins').child(auth.uid).val() === true || newData.parent().parent().parent().child('points').val() === data.parent().parent().parent().child('points').val() - 500)"
            }
          },
          "acc": {
            "$i": {
              ".write": "auth != null && ((auth.uid === $uid && newData.exists()) || root.child('admins').child(auth.uid).val() === true)",
              ".validate": "newData.val() === true && $i.matches(/^(crown|beanie|cap|beret|glasses|sunglasses|heartglasses|bowtie|scarf|hoodie|raincoat|overalls|dress|sneakers|boots|backpack)$/) && (data.exists() || root.child('admins').child(auth.uid).val() === true || newData.parent().parent().parent().child('points').val() === data.parent().parent().parent().child('points').val() - 300)"
            }
          }
        },
        "look": {
          ".write": "auth != null && auth.uid === $uid",
          "a": {
            ".validate": "newData.isString() && (newData.val() === 'cat' || newData.parent().parent().child('owned/animals').child(newData.val()).val() === true)"
          },
          "head": {
            ".validate": "newData.isString() && newData.val().matches(/^(crown|beanie|cap|beret)$/) && newData.parent().parent().child('owned/acc').child(newData.val()).val() === true"
          },
          "eyes": {
            ".validate": "newData.isString() && newData.val().matches(/^(glasses|sunglasses|heartglasses)$/) && newData.parent().parent().child('owned/acc').child(newData.val()).val() === true"
          },
          "neck": {
            ".validate": "newData.isString() && newData.val().matches(/^(bowtie|scarf)$/) && newData.parent().parent().child('owned/acc').child(newData.val()).val() === true"
          },
          "body": {
            ".validate": "newData.isString() && newData.val().matches(/^(hoodie|raincoat|overalls|dress)$/) && newData.parent().parent().child('owned/acc').child(newData.val()).val() === true"
          },
          "feet": {
            ".validate": "newData.isString() && newData.val().matches(/^(sneakers|boots)$/) && newData.parent().parent().child('owned/acc').child(newData.val()).val() === true"
          },
          "back": {
            ".validate": "newData.isString() && newData.val().matches(/^(backpack)$/) && newData.parent().parent().child('owned/acc').child(newData.val()).val() === true"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "claims": {
      ".read": "auth != null",
      "$rid": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber()"
        }
      }
    },
    "roomIndex": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true",
        ".validate": "$code.matches(/^[A-Z0-9]{4}$/) && newData.child('lastActive').val() === now"
      }
    },
    "maint": {
      ".read": "auth != null",
      "lastCleanup": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true",
        ".validate": "newData.val() === now"
      }
    },
    "dailyPaid": {
      ".read": "auth != null",
      "$date": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true && !data.exists()"
      }
    },
    "rooms": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true",
        ".validate": "$code.matches(/^[A-Z0-9]{4}$/)",
        "mode": {
          ".validate": "newData.val() === 'time' || newData.val() === 'clicks' || newData.val() === 'relay'"
        },
        "legs": {
          ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 5"
        },
        "timeLimitMin": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30"
        },
        "state": {
          ".validate": "newData.val() === 'lobby' || newData.val() === 'playing' || newData.val() === 'results'"
        },
        "rid": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "chat": {
          "$msg": {
            ".validate": "newData.hasChildren(['pid', 'text'])",
            "text": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            }
          }
        },
        "players": {
          "$pid": {
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "path": {
              ".validate": "newData.hasChildren()"
            },
            "char": {
              "a": {
                ".validate": "newData.isString() && (newData.val() === 'cat' || root.child('users').child($pid).child('owned/animals').child(newData.val()).val() === true)"
              },
              "head": {
                ".validate": "newData.isString() && newData.val().matches(/^(crown|beanie|cap|beret)$/) && root.child('users').child($pid).child('owned/acc').child(newData.val()).val() === true"
              },
              "eyes": {
                ".validate": "newData.isString() && newData.val().matches(/^(glasses|sunglasses|heartglasses)$/) && root.child('users').child($pid).child('owned/acc').child(newData.val()).val() === true"
              },
              "neck": {
                ".validate": "newData.isString() && newData.val().matches(/^(bowtie|scarf)$/) && root.child('users').child($pid).child('owned/acc').child(newData.val()).val() === true"
              },
              "body": {
                ".validate": "newData.isString() && newData.val().matches(/^(hoodie|raincoat|overalls|dress)$/) && root.child('users').child($pid).child('owned/acc').child(newData.val()).val() === true"
              },
              "feet": {
                ".validate": "newData.isString() && newData.val().matches(/^(sneakers|boots)$/) && root.child('users').child($pid).child('owned/acc').child(newData.val()).val() === true"
              },
              "back": {
                ".validate": "newData.isString() && newData.val().matches(/^(backpack)$/) && root.child('users').child($pid).child('owned/acc').child(newData.val()).val() === true"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        }
      }
    },
    "lobbies": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true",
        ".validate": "$code.matches(/^[A-Z0-9]{4}$/)",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "count": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30"
        }
      }
    },
    "daily": {
      ".read": "auth != null",
      "$date": {
        ".validate": "$date.matches(/^20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/)",
        "puzzle": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true && !data.exists()",
          ".validate": "newData.hasChildren(['start', 'targets'])"
        },
        "best": {
          "$pid": {
            ".write": "auth != null && root.child('users').child(auth.uid).child('approved').val() === true && (auth.uid === $pid || root.child('admins').child(auth.uid).val() === true)",
            ".validate": "newData.hasChildren(['name', 'ms'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "ms": {
              ".validate": "newData.isNumber() && newData.val() > 0"
            },
            "at": {
              ".validate": "newData.val() === now"
            }
          }
        }
      }
    }
  }
}
