{
  "manifest_version": 3,
  "name": "나무위키 레이스 도우미",
  "version": "1.9.0",
  "description": "나무위키 레이스 게임에서 나무위키 문서 이동과 클릭 수를 자동으로 기록합니다.",
  "permissions": ["storage"],
  "host_permissions": ["https://ko.wikipedia.org/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://namu.wiki/*"],
      "js": ["namu.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://yeowon811.github.io/namuwiki-game/*", "http://localhost:5500/*"],
      "js": ["game.js"],
      "run_at": "document_end"
    }
  ]
}
